{
  "expo": {
    "name": "Edurise LMS",
    "slug": "EduriseLMS",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/appicon.png",
    "scheme": "edurise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#48C78E",
        "foregroundImage": "./assets/images/appicon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pratapsingh9.EduriseLMS",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#48C78E"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your AI Tutor.",
          "cameraPermission": "The app accesses your camera to let you take photos and share them with your AI Tutor."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "praaatap"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Dark",
            "ios": "./assets/images/app-icons/icon-dark.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-dark.png",
              "backgroundColor": "#1a1a2e"
            }
          },
          {
            "name": "Green",
            "ios": "./assets/images/app-icons/icon-green.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-green.png",
              "backgroundColor": "#22C55E"
            }
          },
          {
            "name": "Blue",
            "ios": "./assets/images/app-icons/icon-blue.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-blue.png",
              "backgroundColor": "#3B82F6"
            }
          },
          {
            "name": "Purple",
            "ios": "./assets/images/app-icons/icon-purple.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-purple.png",
              "backgroundColor": "#8B5CF6"
            }
          },
          {
            "name": "Minimal",
            "ios": "./assets/images/app-icons/icon-minimal.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-minimal.png",
              "backgroundColor": "#64748B"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3b1f6c9-3e0c-4160-8879-5bc2394ca0fa"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {}
  }
}
