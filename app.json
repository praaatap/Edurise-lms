{
  "expo": {
    "name": "Edurise LMS",
    "slug": "EduriseLMS",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/appicon.png",
    "scheme": "edurise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/e3b1f6c9-3e0c-4160-8879-5bc2394ca0fa"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#48C78E",
        "foregroundImage": "./assets/images/appicon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pratapsingh9.EduriseLMS"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/appicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#48C78E"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your AI Tutor.",
          "cameraPermission": "The app accesses your camera to let you take photos and share them with your AI Tutor."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "praaatap"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},

      
      "eas": {
        "projectId": "e3b1f6c9-3e0c-4160-8879-5bc2394ca0fa"
      }
    }
  }
}
